# ==============================================================================
# CICOD & 1Gov Autonomous AI Health Monitor Configuration
# Copy this file to .env and fill in your credentials / alert keys.
# ==============================================================================

# --- AI Triage Brain (Gemini Vision + Root Cause Analyst) ---
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Browser Execution ---
# Uses Microsoft Edge installed on Windows ("msedge") or "chrome"
BROWSER_CHANNEL=msedge
HEADLESS=true

# --- Target 1: CICOD SaaS Staging ---
CICOD_LOGIN_URL=https://cicodsaasstaging.com/signin
CICOD_TENANT=cicodecms
CICOD_EMAIL=
CICOD_PASSWORD=

# --- Target 2: 1Gov Cloud Staging ---
GOV_LOGIN_URL=https://govtest.convergenceondemand.com/login
GOV_TENANT=govtest
GOV_EMAIL=
GOV_PASSWORD=

# --- Alert & Feedback Channels (Optional) ---
# Slack / Microsoft Teams / Discord Incoming Webhook URL
ALERT_WEBHOOK_URL=

# Email Alerts via Resend (https://resend.com)
RESEND_API_KEY=
ALERT_EMAIL_FROM="CICOD Health Monitor <no-reply@parkly.sellytichq.com>"
ALERT_EMAIL_TO=
ALERT_ON_STATUS=HEALTHY,DEGRADED,DOWN

